# Model provider: set ANTHROPIC_API_KEY or OPENAI_API_KEY.
# MODEL_PROVIDER picks one explicitly; left empty, Anthropic wins if both keys are set.
MODEL_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: use one OpenAI model for every profile, or an OpenAI-compatible endpoint.
OPENAI_MODEL=
OPENAI_BASE_URL=

# StacyVM
STACYVM_URL=http://localhost:7423
STACYVM_API_KEY=

# Default sandbox image / ttl for the test harness
SANDBOX_IMAGE=stacy-evm:latest
SANDBOX_TTL=30m

# Postgres (for checkpointer + agent metadata)
DATABASE_URL=postgresql://stacyvm:stacyvm@localhost:5432/stacyvm

# Optional
TAVILY_API_KEY=


DEPLOY_IDEMPOTENCY_TTL_MINUTES=2
# Agent HTTP server used by the IDE
AGENT_SERVER_PORT=8787
AGENT_SERVER_CORS_ORIGINS=http://localhost:3000
